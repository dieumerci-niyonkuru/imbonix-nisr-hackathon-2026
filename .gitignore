# Dependencies and build output
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
# Generated by next dev, next build and next typegen
next-env.d.ts
.eslintcache

# Environment and secrets: only .env.example files are committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# Logs and local runtime files
*.log
npm-debug.log*
*.pid

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Database files and dumps (IMBONIX has no database; never commit dumps of one)
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Data: raw and working files stay local (microdata terms forbid redistribution)
data/raw/
data/interim/
data/processed/
# Trained model files, once the planned model exists
ml/models/artifacts/

# Copied from node_modules before dev/build (scripts/copy-maplibre-worker.mjs)
apps/web/public/vendor/
