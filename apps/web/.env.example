NEXT_PUBLIC_API_URL=http://localhost:4000

# IMBONIX AI (optional). Set EITHER key to power the generative assistant and its picture/document reading.
# Without one, IMBONIX AI still works: it falls back to the instant on-device engine over the same NISR figures.
# Keys are read only on the server (apps/web/src/app/api/assistant/route.ts) and are never sent to the browser.

# Free option (no credit card): Google Gemini. Get one at https://aistudio.google.com/apikey — starts with "AIza".
GEMINI_API_KEY=

# Paid alternative: Anthropic Claude (used instead of Gemini when set). https://console.anthropic.com — starts with "sk-ant-".
ANTHROPIC_API_KEY=
