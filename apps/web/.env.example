# Live JSON API (optional). The base URL of the IMBONIX API (apps/api). When set, the /data page shows a live
# "Connected" status for the public API and the counts it serves. It is read only on the server (apps/web/src/app/api/
# live/route.ts), so the URL is never sent to the browser and no CORS is needed. Leave it unset and the site still works
# fully (the data is built in); the API panel just shows the published endpoints without a live status.
# Local: http://localhost:4000 . On Railway: the API service's URL, e.g. https://imbonix-api.up.railway.app
#        or the private address https://imbonix-api.railway.internal (reached server-side only).
API_URL=

# IMBONIX AI (optional). Set EITHER key to power the generative assistant and its picture/document reading.
# Without one, IMBONIX AI still works: it falls back to the instant on-device engine over the same NISR figures.
# Keys are read only on the server (apps/web/src/app/api/assistant/route.ts) and are never sent to the browser.

# Free option (no credit card): Google Gemini. Get one at https://aistudio.google.com/apikey — starts with "AIza".
GEMINI_API_KEY=

# Paid alternative: Anthropic Claude (used instead of Gemini when set). https://console.anthropic.com — starts with "sk-ant-".
ANTHROPIC_API_KEY=
