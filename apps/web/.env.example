NEXT_PUBLIC_API_URL=http://localhost:4000

# IMBONIX AI (optional). Set this to power the generative assistant and its picture/document reading.
# Without it, IMBONIX AI still works: it falls back to the instant on-device engine over the same NISR figures.
# The key is read only on the server (apps/web/src/app/api/assistant/route.ts) and is never sent to the browser.
# Get one at https://console.anthropic.com — keep it out of git (.env is gitignored).
ANTHROPIC_API_KEY=
