# Copy to .env for local use only; never commit .env. On a host, set these as environment variables.
# Every setting is optional: the values below are the defaults.

# development | production | test
NODE_ENV=development
PORT=4000
# Interface to listen on. Leave empty for all interfaces (IPv4 and IPv6).
HOST=

# Comma-separated origins allowed to call the API from a browser, e.g. https://imbonix.example.
# Use * only for a fully public API.
CORS_ORIGINS=http://localhost:3000

# Requests per minute per client IP on /api/v1 (the health check is not limited).
RATE_LIMIT_PER_MINUTE=120
# Number of proxies in front of the API (0 when run directly, usually 1 behind a platform router or load balancer).
TRUST_PROXY=0

# silent | error | warn | info | debug
LOG_LEVEL=info

# Folder with districts.json and sectors.json. Defaults to apps/web/src/data/generated in this repository.
DATA_DIR=
